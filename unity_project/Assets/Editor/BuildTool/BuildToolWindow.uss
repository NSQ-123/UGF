/* 根容器 */
.root-container {
    padding: 10px;
    background-color: rgb(56, 56, 56);
}

/* 标题 */
.title {
    font-size: 18px;
    font-weight: bold;
    margin-bottom: 15px;
    color: rgb(255, 255, 255);
}

/* 配置容器 */
.config-container {
    margin-bottom: 15px;
    padding: 10px;
    background-color: rgb(40, 40, 40);
    border-radius: 4px;
}

/* 字段容器 */
.field-container {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.field-label {
    width: 100px;
    color: rgb(200, 200, 200);
    margin-right: 10px;
}

/* 按钮容器 */
.button-container {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 15px;
}

/* 构建按钮 */
.build-button {
    min-width: 150px;
    height: 30px;
    background-color: rgb(0, 120, 215);
    color: rgb(255, 255, 255);
    border-radius: 4px;
    font-size: 13px;
}

.build-button:hover {
    background-color: rgb(0, 140, 235);
}

.build-button:active {
    background-color: rgb(0, 100, 195);
}

.build-button:disabled {
    background-color: rgb(60, 60, 60);
    color: rgb(120, 120, 120);
}

/* 构建全部按钮 */
.build-all-button {
    background-color: rgb(0, 180, 0);
    min-width: 200px;
}

.build-all-button:hover {
    background-color: rgb(0, 200, 0);
}

.build-all-button:active {
    background-color: rgb(0, 160, 0);
}

/* 进度条 */
.progress-bar {
    margin-bottom: 15px;
    height: 25px;
}

/* 日志容器 */
.log-container {
    flex-grow: 1;
    border-top-width: 1px;
    border-top-color: rgb(80, 80, 80);
    padding-top: 10px;
}

.log-title {
    font-size: 14px;
    font-weight: bold;
    margin-bottom: 5px;
    color: rgb(255, 255, 255);
}

.log-scroll-view {
    flex-grow: 1;
    background-color: rgb(30, 30, 30);
    border-radius: 4px;
    padding: 10px;
    min-height: 200px;
}

.log-label {
    white-space: normal;
    color: rgb(200, 200, 200);
    font-size: 12px;
    font-family: 'Consolas', 'Courier New', monospace;
}

/* EnumField 和 TextField 样式 */
TextField,
EnumField {
    width: 200px;
    background-color: rgb(50, 50, 50);
    color: rgb(255, 255, 255);
    border-radius: 4px;
}

Toggle {
    color: rgb(200, 200, 200);
}

